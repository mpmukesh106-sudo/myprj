{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/login/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/diagnostics/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/troubleshooting/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/automata/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/performance/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/history/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/reports/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/about/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
