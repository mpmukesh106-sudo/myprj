{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/login/:path*",
          "destination": "/"
        },
        {
          "source": "/diagnostics/:path*",
          "destination": "/"
        },
        {
          "source": "/troubleshooting/:path*",
          "destination": "/"
        },
        {
          "source": "/automata/:path*",
          "destination": "/"
        },
        {
          "source": "/performance/:path*",
          "destination": "/"
        },
        {
          "source": "/history/:path*",
          "destination": "/"
        },
        {
          "source": "/reports/:path*",
          "destination": "/"
        },
        {
          "source": "/about/:path*",
          "destination": "/"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
